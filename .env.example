# Coobi Logistics - environment template.
#
# This file is the source of truth for the environment contract: the complete
# set of variable names, the development default of each one (where a default
# is safe to publish), its unit and its scope. README.md documents the same
# contract and is kept synchronized with this file.
#
# Usage: copy this file to `.env` and fill in the values that have no default.
#
#   PowerShell:  Copy-Item .env.example .env
#   POSIX shell: cp .env.example .env
#
# `.env` is ignored by Git (see .gitignore) and must never be committed.
#
# Configuration is read from the environment of each process. The values below
# are development values for a local stack, never production values. A value
# already present in the process environment wins over any fallback baked into
# a service, so the same image can run with different local setups.
#
# The Compose definition (MVP-0.2, completed by MVP-10) interpolates `${POSTGRES_DB}`,
# `${POSTGRES_USER}` and `${POSTGRES_PASSWORD}` for the `postgres` service. Values
# may come from this file or from the shell environment, and a variable exported
# in the shell wins over the value copied into `.env`. Compose resolves that
# interpolation before it creates any container, so a missing or empty
# `POSTGRES_PASSWORD` aborts the command instead of starting the stack without a
# password.
#
# The three application services of the stack read this file as well: `compose.yml`
# passes it to them (its `env_file`), so one file configures the infrastructure, the
# services and their published ports, and a variable this file does not define keeps
# the default the service itself declares in its `application.yml`. The handful of
# values that are not the same inside the network as on the host - the addresses of
# Kafka, of PostgreSQL and of the metrics endpoint of the stream-processor - are set
# by `compose.yml` explicitly instead, because a host default such as `localhost`
# would point a container at itself. A host default in this file therefore never
# misconfigures a container, and it still configures a service somebody starts from
# the host with the Maven wrapper.
#
# A literal `$` inside a value must be doubled, because Compose interpolates `$`
# in `.env`: a value written as `pa$$word` resolves to `pa$word`.

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

# Bootstrap servers used by the services to reach Kafka.
# Default scope: services launched from the host (Maven or IDE), reaching a
# broker published on the host by the MVP-0.2 Compose stack.
# The containerized services of the MVP-10 stack do not read this value: `compose.yml`
# sets their `KAFKA_BOOTSTRAP_SERVERS` to the in-network listener `kafka:29092`.
# Format: comma-separated list of `host:port` entries.
# Scope: event-generator, stream-processor, logistics-api.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Database name used by the stack.
# Scope: postgres container, stream-processor, logistics-api.
POSTGRES_DB=logistics

# Database role used by the stack.
# Scope: postgres container, stream-processor, logistics-api.
POSTGRES_USER=logistics

# Database password for `POSTGRES_USER`.
# Scope: postgres container, stream-processor, logistics-api.
# No value is shipped here on purpose. A published password would be a
# version-controlled credential, and an empty password is not a usable
# configuration. Assign your own local value in `.env` before starting any
# stack, and keep it out of version control.
# Compose aborts before creating any container when this variable is missing or
# empty, instead of falling back to a default.
POSTGRES_PASSWORD=

# The three variables above are also the local defaults of the persistence layer of the
# stream-processor (MVP-4): the service reads `POSTGRES_DB`, `POSTGRES_USER` and
# `POSTGRES_PASSWORD` when the standard Spring overrides below are absent, so one `.env`
# configures the whole local stack, and Flyway applies the service migrations on startup.
# The containers of the MVP-10 stack are given the same three values, and a JDBC URL that
# names the `postgres` service of the network instead of `localhost`.
#
# Overrides, for a database that is not the local Compose service. They are the standard
# Spring datasource names, so any other Spring datasource setting (pool size, driver, SSL
# parameters) can be set the same way. They are documented rather than shipped as active
# entries, because an empty `SPRING_DATASOURCE_PASSWORD=` would override - and not fall
# back to - `POSTGRES_PASSWORD`:
#
#   SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/logistics
#   SPRING_DATASOURCE_USERNAME=logistics
#   SPRING_DATASOURCE_PASSWORD=<the same local password as POSTGRES_PASSWORD>

# ---------------------------------------------------------------------------
# Observability (MVP-8)
# ---------------------------------------------------------------------------
#
# Prometheus scrapes the Actuator endpoints of the two stream services
# (`/actuator/prometheus`) and stores what it reads in its own volume. It runs in a
# container of the local stack, next to the two services it scrapes, so the default targets
# are the service names of `compose.yml`.
#
# The scrape configuration is versioned in
# `infrastructure/prometheus/prometheus.yml`, and it holds no environment variable: the two
# targets are the service names of the stack, written out in that file. Prometheus expands
# `${VAR}` references of its configuration in `external_labels` and nowhere else, so a
# variable in a target would be scraped as its own name - which is what the single
# `PROMETHEUS_HOST` of MVP-8 did. To scrape a service somebody started from the host instead
# of the container, change its target in that file to `host.docker.internal:8080` (or
# `:8081`); `compose.yml` maps that name on a Linux engine as well.
# The counters, the visibility of each metric and the queries worth running are documented
# in `docs/observability.md`.

# ---------------------------------------------------------------------------
# Vehicle simulator (event-generator)
# ---------------------------------------------------------------------------

# Operating profile of the generator.
# NORMAL    uses VEHICLE_COUNT and TARGET_EVENTS_PER_SECOND (demonstration values).
# LOAD_TEST uses LOAD_TEST_VEHICLE_COUNT and LOAD_TEST_TARGET_EVENTS_PER_SECOND.
# Values: NORMAL | LOAD_TEST.
# Scope: event-generator.
GENERATOR_MODE=NORMAL

# Number of simulated vehicles kept active by the generator.
# Unit: vehicles (count).
# Scope: event-generator, NORMAL mode.
VEHICLE_COUNT=1000

# Target telemetry publication rate of the generator.
# Unit: events per second.
# Scope: event-generator, NORMAL mode.
TARGET_EVENTS_PER_SECOND=1000

# Whether the generator publishes telemetry. `false` starts the service and its
# endpoints (health, metrics) and still provisions the topics, but produces no
# events. It does not remove the broker requirement: topic provisioning and the
# Kafka health indicator still contact KAFKA_BOOTSTRAP_SERVERS, so the service
# still fails fast when no broker answers.
# Values: true | false.
# Scope: event-generator.
GENERATOR_PUBLISH_ENABLED=true

# Whether the generator provisions its two Kafka topics on startup. This is the
# relaxed-binding environment form of `coobi.kafka.initialization.enabled`.
# The shipped default is `true`: provisioning is what makes the topic topology
# reproducible, and an unreachable broker aborts startup instead of letting the
# generator run with no destination.
# Set it to `false` to start the service without any broker (offline work,
# tests). The topics must then already exist before the generator publishes.
# Values: true | false.
# Scope: event-generator and stream-processor, offline and test runs. The
# stream-processor also needs SPRING_KAFKA_STREAMS_AUTO_STARTUP=false to keep its
# topology from starting, and MANAGEMENT_HEALTH_KAFKA_ENABLED=false to keep
# /actuator/health UP without a broker.
COOBI_KAFKA_INITIALIZATION_ENABLED=true

# Number of simulated vehicles used while GENERATOR_MODE=LOAD_TEST.
# Unit: vehicles (count).
# Scope: event-generator, LOAD_TEST mode.
LOAD_TEST_VEHICLE_COUNT=5000

# Target telemetry publication rate used while GENERATOR_MODE=LOAD_TEST.
# Unit: events per second.
# Scope: event-generator, LOAD_TEST mode.
LOAD_TEST_TARGET_EVENTS_PER_SECOND=20000

# How long a load test publishes before the generator stops on its own.
# Consumed by the event-generator in LOAD_TEST mode (MVP-11.1). When it elapses the
# publishing task stops and the service stays up - its health and its metrics keep
# answering - so a bounded benchmark ends the load without ending the pipeline. A run that
# keeps publishing until somebody stops the service is the `0` of this value.
# Unit: seconds, or a Spring duration such as `5m`, `90s` or `1h`.
# Scope: event-generator, LOAD_TEST mode.
LOAD_TEST_DURATION=0

# Seed of the deterministic trajectory generator: the same seed always replays the
# same fleet and the same movement, which keeps local runs reproducible.
# Unit: long.
# Scope: event-generator.
GENERATOR_RANDOM_SEED=20260101

# ---------------------------------------------------------------------------
# Benchmarks (MVP-11)
# ---------------------------------------------------------------------------
#
# A benchmark is not configured from this file. `infrastructure/benchmarks/benchmark.py`
# starts the stack with the overlay `infrastructure/benchmarks/compose.benchmark.yml`, which
# drives the generator in LOAD_TEST mode and asks the stream-processor for its `benchmark`
# Spring profile. The harness passes the three values below in the environment of the Compose
# process, so they never have to be written here:
#
#   BENCH_VEHICLES=<the fleet of the scenario>
#   BENCH_TARGET_EVENTS_PER_SECOND=<the target rate of the scenario>
#   BENCH_LOAD_TEST_DURATION=<the window of the scenario plus the allowance of the run>
#
# The complete procedure, the scenarios and the measured results are documented in
# docs/benchmarks.md.

# ---------------------------------------------------------------------------
# Detection thresholds (stream-processor)
# ---------------------------------------------------------------------------

# Speed above which a vehicle is reported as speeding.
# Consumed by the stream-processor (MVP-2.3): the first telemetry above this
# limit moves a vehicle from NORMAL to SPEEDING and produces exactly one alert,
# and telemetry at or below it moves it back to NORMAL.
# Unit: kilometres per hour (km/h).
SPEED_LIMIT=120

# Time a vehicle must remain effectively stationary before it is reported as
# stopped.
# Consumed by the stream-processor (MVP-3.2): the `vehicle-state` processor adds up
# the distance between consecutive positions and reports the vehicle stopped once it
# stays below MOVEMENT_THRESHOLD_METERS for this long.
# Unit: seconds.
STOPPED_WINDOW_SECONDS=300

# Total distance below which movement is treated as "no movement" over the
# stopped window.
# Consumed by the stream-processor (MVP-3.2), next to STOPPED_WINDOW_SECONDS.
# Unit: metres.
MOVEMENT_THRESHOLD_METERS=50

# ---------------------------------------------------------------------------
# Read access (logistics-api)
# ---------------------------------------------------------------------------

# Actuator metrics endpoint of the stream-processor, read by
# GET /api/v1/statistics to report how many records the topology has processed.
# Consumed by the logistics-api (MVP-5.4). A processor that does not answer is not
# an error: the endpoint stays available and reports `processedEvents` and
# `eventsPerSecond` as null instead of a number that only looks live.
# Default scope: API launched from the host, reaching the processor published on
# the host port. The containerized API of the MVP-10 stack does not read this value:
# `compose.yml` sets it to `http://stream-processor:8081/actuator/metrics`, the
# service name of the network.
# Format: URL of the metrics endpoint, without a metric name.
# Scope: logistics-api.
STREAM_PROCESSOR_METRICS_URL=http://localhost:8081/actuator/metrics

# ---------------------------------------------------------------------------
# Browser streams (logistics-api)
# ---------------------------------------------------------------------------
#
# What a browser may receive over Server-Sent Events, and what one may cost.
# A stream never forwards the throughput of the pipeline: every tick reads the
# read model the processor has already written and sends at most the two
# maxima below, so the volume one browser receives is a property of this
# configuration and not of the load of the stack. An endpoint with no browser
# connected has no ticker at all, so an API nobody watches reads nothing.
#
# Consumed by the logistics-api (MVP-6):
#   GET /api/v1/stream/events      the sampled `alert` and `vehicle` events
#   GET /api/v1/stream/statistics  the live statistics of /api/v1/statistics
#
# The frames held for one browser that has not read them (256) and the silence
# before a heartbeat comment (15s) are properties of the response format rather
# than of a deployment: they are documented in docs/logistics-api.md and can
# still be overridden with relaxed binding, for example
# COOBI_STREAM_CLIENT_BUFFER_SIZE=64 or COOBI_STREAM_CLIENT_HEARTBEAT_INTERVAL=5s.

# How often the event stream reads the read model for events new since the
# previous tick. Lower values make a dashboard feel more immediate and read the
# database more often.
# Format: Spring duration.
# Scope: logistics-api.
COOBI_STREAM_EVENTS_POLL_INTERVAL=1s

# Most alerts one tick of the event stream may carry. A burst larger than this
# is sampled - the newest events are sent - rather than queued.
# Unit: alerts per tick.
# Scope: logistics-api.
COOBI_STREAM_EVENTS_MAX_ALERTS_PER_POLL=20

# Most vehicle states one tick of the event stream may carry, with the same
# sampling rule as the alerts.
# Unit: vehicle states per tick.
# Scope: logistics-api.
COOBI_STREAM_EVENTS_MAX_VEHICLES_PER_POLL=30

# How often the statistics stream reads and sends the live statistics. One
# second is the documented default: live enough for a dashboard, cheap enough
# that many browsers cost one read per interval.
# Format: Spring duration.
# Scope: logistics-api.
COOBI_STREAM_STATISTICS_INTERVAL=1s

# Browsers one stream serves at a time. The next connection is answered `503`
# with a problem detail instead of being queued, so the service never holds a
# connection it cannot serve.
# Unit: connections per stream.
# Scope: logistics-api.
COOBI_STREAM_CLIENT_MAX_SUBSCRIBERS=32

# ---------------------------------------------------------------------------
# Frontend (MVP-7)
# ---------------------------------------------------------------------------

# The dashboard is built by Vite and configured at build time rather than from
# the environment of a running service, so its values are read from the template
# of its own directory. `frontend/.env.example` is the source of truth for them
# and is repeated here only as a pointer:
#
#   VITE_API_BASE_URL       origin of the API. Empty means the origin that served
#                           the dashboard - the app calls `/api/v1/...` on itself,
#                           which is what the Vite dev and preview servers proxy.
#   VITE_API_PROXY_TARGET   origin those two servers proxy `/api` to,
#                           `http://localhost:8082` by default. It never reaches
#                           the browser bundle.
#
# Neither value is a secret: both are baked into the bundle the browser loads.
# Scope: frontend build.
#
# The dashboard container of the MVP-10 stack serves the same bundle from its own origin and
# proxies `/api` itself, so the two values above are not the ones that configure it. The
# container is pointed at the API with the variable below, which its nginx server reads when
# the container starts.

# Origin the dashboard container proxies `/api` to.
# The default is the logistics API of this stack by its service name. Change it to serve the
# dashboard against an API somewhere else the container can reach.
# Format: scheme://host:port, no trailing slash and no path.
# Scope: frontend container.
API_PROXY_TARGET=http://logistics-api:8082

# Coobi Logistics - environment template.
#
# This file is the source of truth for the environment contract: the complete
# set of variable names, the development default of each one (where a default
# is safe to publish), its unit and its scope. README.md documents the same
# contract and is kept synchronized with this file.
#
# Usage: copy this file to `.env` and fill in the values that have no default.
#
#   PowerShell:  Copy-Item .env.example .env
#   POSIX shell: cp .env.example .env
#
# `.env` is ignored by Git (see .gitignore) and must never be committed.
#
# Configuration is read from the environment of each process. The values below
# are development values for a local stack, never production values. A value
# already present in the process environment wins over any fallback baked into
# a service, so the same image can run with different local setups.
#
# The Compose definition (MVP-0.2) interpolates `${POSTGRES_DB}`,
# `${POSTGRES_USER}` and `${POSTGRES_PASSWORD}` for the `postgres` service. Values
# may come from this file or from the shell environment, and a variable exported
# in the shell wins over the value copied into `.env`. Compose resolves that
# interpolation before it creates any container, so a missing or empty
# `POSTGRES_PASSWORD` aborts the command instead of starting the stack without a
# password. The remaining variables are read by the application services, and
# none of those services exists yet.
#
# A literal `$` inside a value must be doubled, because Compose interpolates `$`
# in `.env`: a value written as `pa$$word` resolves to `pa$word`.

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

# Bootstrap servers used by the services to reach Kafka.
# Default scope: services launched from the host (Maven or IDE), reaching a
# broker published on the host by the MVP-0.2 Compose stack.
# Services running inside a container will need their own network override: the
# in-network hostname and port are `kafka:29092`, defined by `compose.yml`.
# Format: comma-separated list of `host:port` entries.
# Scope: event-generator, stream-processor, logistics-api.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Database name used by the stack.
# Scope: postgres container, stream-processor, logistics-api.
POSTGRES_DB=logistics

# Database role used by the stack.
# Scope: postgres container, stream-processor, logistics-api.
POSTGRES_USER=logistics

# Database password for `POSTGRES_USER`.
# Scope: postgres container, stream-processor, logistics-api.
# No value is shipped here on purpose. A published password would be a
# version-controlled credential, and an empty password is not a usable
# configuration. Assign your own local value in `.env` before starting any
# stack, and keep it out of version control.
# Compose aborts before creating any container when this variable is missing or
# empty, instead of falling back to a default.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Vehicle simulator (event-generator)
# ---------------------------------------------------------------------------

# Number of simulated vehicles kept active by the generator.
# Unit: vehicles (count).
VEHICLE_COUNT=1000

# Target telemetry publication rate of the generator.
# Unit: events per second.
TARGET_EVENTS_PER_SECOND=1000

# ---------------------------------------------------------------------------
# Detection thresholds (stream-processor)
# ---------------------------------------------------------------------------

# Speed above which a vehicle is reported as speeding.
# Unit: kilometres per hour (km/h).
SPEED_LIMIT=120

# Time a vehicle must remain effectively stationary before it is reported as
# stopped.
# Unit: seconds.
STOPPED_WINDOW_SECONDS=300

# Total distance below which movement is treated as "no movement" over the
# stopped window.
# Unit: metres.
MOVEMENT_THRESHOLD_METERS=50

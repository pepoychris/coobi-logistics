# Coobi Logistics - frontend environment template (MVP-7).
#
# Usage: copy this file to `.env` and override what your machine needs.
#
#   PowerShell:  Copy-Item frontend/.env.example frontend/.env
#   POSIX shell: cp frontend/.env.example frontend/.env
#
# Vite reads this file from the `frontend` directory at build time, so these
# values are baked into the bundle and must never hold a secret. They are also
# build-time values: changing one requires a rebuild.

# Where the dashboard reaches the logistics API.
#
# Empty is the documented local default, and it means "this origin": the
# dashboard calls `/api/v1/...` on the origin that served it, and the Vite dev
# and preview servers proxy `/api` to the API of the local stack
# (`VITE_API_PROXY_TARGET` below). The API of MVP-5 and MVP-6 ships no CORS
# configuration, so a same-origin path is the one that works out of the box in a
# browser.
#
# Set an absolute URL only when the API of that origin is reachable from the
# browser - behind a reverse proxy that serves both, or with CORS enabled on the
# API. Example: VITE_API_BASE_URL=http://localhost:8082
#
# Scope: frontend build.
VITE_API_BASE_URL=

# Origin the dev and preview servers proxy `/api` to. It is used only by those
# two servers and never reaches the browser bundle.
#
# Format: scheme://host:port, no trailing slash and no path.
# Scope: frontend dev and preview servers.
VITE_API_PROXY_TARGET=http://localhost:8082
